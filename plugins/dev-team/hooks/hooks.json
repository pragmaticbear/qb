{
  "description": "dev-team: phase lock (blocks code edits during plan/review) and delivery quality gate (runs project checks when a developer subagent stops). Both are inert unless .claude/dev-team/state exists.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/phase-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/quality-gate.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
